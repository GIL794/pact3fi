datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Invoice {
  id               String    @id
  ownerAddress     String    @default("")
  amount           String
  currency         String
  description      String
  recipientAddress String
  recipientName    String?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime?
  status           String    @default("pending") // 'pending' | 'paid' | 'expired'
  txHash           String?   @unique
  feeTxHash        String?
  paidAt           DateTime?
  paidBy           String?
  fee              String?
  network          String    @default("arc") // 'arc' | 'algorand'
  isSystem         Boolean   @default(false)
  updatedAt        DateTime  @updatedAt

  @@index([ownerAddress, network, status])
  @@index([network, status])
  @@index([recipientAddress])
}

model Subscription {
  id        String   @id @default(cuid())
  address   String   @unique
  tier      String   @default("free") // 'free' | 'pro' | 'business'
  txHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InvoiceUsage {
  id            String   @id @default(cuid())
  ownerAddress  String
  network       String
  billingMonth  String // Format: YYYY-MM, e.g. "2026-08"
  invoicesUsed  Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([ownerAddress, network, billingMonth])
  @@index([ownerAddress, network])
}

model AgentLog {
  id        String   @id @default(cuid())
  action    String
  details   String
  txHash    String?
  status    String   @default("success")
  createdAt DateTime @default(now())
}
