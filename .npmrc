# npm configuration for Pactopus
# Required for Vercel build: @circle-fin/developer-controlled-wallets 10.8.0 carries
# peerOptional @solana/kit@^2||^3||^4||^5||^6 (Solana SDK chain of packages),
# which Vercel's strict default npm resolver fails as ERESOLVE. The Solana chain
# is purely optional-peer for Circle SDK (we use Arc/EVM/Algorand only), so we
# fall back to legacy peer deps resolution (matches local install resolver).
legacy-peer-deps=true

# Don't spam audit output on CI/Vercel build logs (speedup + less noise)
audit-level=none

# Skip optional platform binaries we never use (some SDKs ship huge native add-ons)
# optional=false

# Cache strategy for monorepo-like CI (reduces install time on Vercel cold cache)
prefer-offline=false

# Strict package-lock parity between local machine and Vercel build (if lockfile
# out-of-date, fail install with explicit message instead of silently mutating it)
lockfile-version=3
